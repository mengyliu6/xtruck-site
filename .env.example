# Public build-time variables. Values prefixed with VITE_ are visible in the browser.
VITE_CANONICAL_URL=https://www.xtruckohw808.com/
VITE_PAYPAL_CLIENT_ID=replace_with_paypal_client_id

# Server-only PayPal variables for Vercel Functions.
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
PAYPAL_WEBHOOK_ID=replace_with_paypal_webhook_id
PAYPAL_ENV=sandbox

# Server-only Supabase variables for Vercel Functions.
SUPABASE_URL=replace_with_supabase_url
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key

# Server-authoritative product pricing.
PRODUCT_PRICE_USD=2399
PRODUCT_SHIPPING_USD=0

WHATSAPP_NUMBER=replace_with_whatsapp_number

# Server-only admin authentication variables.
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD_HASH=replace_with_generated_scrypt_hash
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters

# Server-only Resend email variables.
RESEND_API_KEY=replace_with_resend_api_key
ORDER_EMAIL_FROM=Xtruck Orders <orders@your_verified_domain.com>
